{
    "name": "@shared/ui",
    "version": "0.1.0",
    "description": "Shared UI component library for SecuPilot and ABBAW - Reusable React components with Tailwind CSS",
    "type": "module",
    "main": "./src/index.js",
    "exports": {
        ".": "./src/index.js",
        "./components/*": "./src/components/*.jsx",
        "./lib/*": "./src/lib/*.js",
        "./styles": "./src/styles/index.css"
    },
    "scripts": {
        "dev": "echo 'This is a component library. Import it in your project.'",
        "build": "echo 'Build script to be added when publishing to npm'"
    },
    "keywords": [
        "react",
        "components",
        "ui",
        "tailwind",
        "design-system"
    ],
    "author": "SECUPILOT",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/kaossar/ui-library.git"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "dependencies": {
        "@radix-ui/react-avatar": "^1.0.4",
        "@radix-ui/react-checkbox": "^1.0.4",
        "@radix-ui/react-dialog": "^1.0.5",
        "@radix-ui/react-label": "^2.0.2",
        "@radix-ui/react-radio-group": "^1.1.3",
        "@radix-ui/react-select": "^2.0.0",
        "@radix-ui/react-separator": "^1.0.3",
        "@radix-ui/react-slot": "^1.0.2",
        "@radix-ui/react-switch": "^1.0.3",
        "@radix-ui/react-tabs": "^1.0.4",
        "@radix-ui/react-tooltip": "^1.0.7",
        "axios": "^1.13.5",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.0.0",
        "date-fns": "^4.4.0",
        "fuse.js": "^7.1.0",
        "i18next": "^25.7.1",
        "lucide-react": "^0.294.0",
        "react-i18next": "^16.5.0",
        "tailwind-merge": "^2.0.0"
    },
    "devDependencies": {
        "tailwindcss": "^3.3.5"
    },
    "overrides": {
        "lucide-react": {
            "react": "$react"
        }
    }
}
